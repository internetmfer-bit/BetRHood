# Copy to .env.local and fill in if you want WalletConnect (QR code / mobile deep link).
# Free to get at https://cloud.reown.com — without it, the app still works fully via the
# injected connector (MetaMask, Coinbase Wallet, any browser extension).
VITE_WALLETCONNECT_PROJECT_ID=

# Optional — a dedicated Robinhood Chain RPC endpoint (Alchemy is what Robinhood's own docs
# recommend: https://docs.robinhood.com/chain/connecting). The public endpoint baked into this
# app is explicitly rate-limited and not meant for production traffic; without this set, every
# page load still works, just against that shared rate limit. This value ends up in the browser
# bundle, so use a key restricted by HTTP referrer/domain (most providers support this) rather
# than an unrestricted one — see frontend/README.md.
VITE_RPC_URL_PRIMARY=
