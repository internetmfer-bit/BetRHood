# Copy this file to .env and fill in real values. .env is gitignored — never commit it,
# never paste its contents anywhere outside your own machine.

# Deployer wallet's private key. Needs real ETH on Robinhood Chain mainnet before deploying
# (no testnet faucet — we're deploying straight to mainnet).
PRIVATE_KEY=

# Only needed if you want `--verify` to auto-verify contracts on the block explorer.
# ETHERSCAN_API_KEY=
